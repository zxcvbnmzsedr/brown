{
  "name": "brown",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n api,app,admin -c cyan,green,magenta \"pnpm dev:server\" \"pnpm dev:app\" \"pnpm dev:admin\"",
    "dev:server": ".venv/bin/uvicorn server.app:app --reload --host 127.0.0.1 --port 8765",
    "dev:app": "pnpm --prefix app run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "dev:admin": "pnpm --prefix admin run dev -- --host 127.0.0.1 --port 5175 --strictPort",
    "build": "pnpm --prefix app run build",
    "build:admin": "pnpm --prefix admin run build",
    "lint": "pnpm --prefix app run lint",
    "lint:admin": "pnpm --prefix admin run lint",
    "test:server": ".venv/bin/python -m pytest server/tests -q"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3"
  }
}
